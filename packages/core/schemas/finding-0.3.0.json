{
  "$ref": "#/definitions/Finding",
  "definitions": {
    "Finding": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "0.3.0"
        },
        "detector": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-z0-9-]+$"
            },
            "algorithmVersion": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"
            }
          },
          "required": [
            "id",
            "algorithmVersion"
          ],
          "additionalProperties": false
        },
        "subject": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "session",
                "project"
              ]
            },
            "ref": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            }
          },
          "required": [
            "kind",
            "ref"
          ],
          "additionalProperties": false
        },
        "confidence": {
          "type": "object",
          "properties": {
            "score": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "basis": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "threshold-only",
                  "count-strength",
                  "repeated-evidence"
                ]
              },
              "minItems": 1
            }
          },
          "required": [
            "score",
            "basis"
          ],
          "additionalProperties": false
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "duplicate-reads",
                  "junk-reads",
                  "reads",
                  "edits",
                  "read-to-edit-ratio"
                ]
              },
              "count": {
                "type": "integer",
                "minimum": 0
              },
              "value": {
                "type": "number",
                "minimum": 0
              },
              "refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{32}$"
                }
              },
              "sessionRefs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{32}$"
                }
              }
            },
            "required": [
              "kind"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "estimate": {
          "type": "object",
          "properties": {
            "metric": {
              "type": "string",
              "enum": [
                "avoidable-tokens",
                "additional-context-tokens"
              ]
            },
            "value": {
              "type": "number",
              "minimum": 0
            },
            "unit": {
              "type": "string",
              "const": "tokens"
            },
            "methodId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z0-9-]+$"
            },
            "methodVersion": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"
            },
            "nonCash": {
              "type": "boolean",
              "const": true
            }
          },
          "required": [
            "metric",
            "value",
            "unit",
            "methodId",
            "methodVersion",
            "nonCash"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "detector",
        "subject",
        "confidence",
        "evidence"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
